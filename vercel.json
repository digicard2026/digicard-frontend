{
  "rewrites": [
    {
      "source": "/preview/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ww]hats[Aa]pp|facebookexternalhit|[Ff]acebot|[Tt]witterbot|[Ll]inked[Ii]n[Bb]ot|[Tt]elegram[Bb]ot|[Ss]lackbot|[Dd]iscordbot|[Aa]pplebot|[Ss]kype[Uu]ri[Pp]review).*"
        }
      ],
      "destination": "https://api.revayah.one/preview/:slug*"
    },
    {
      "source": "/p/:slug*",
      "destination": "https://api.revayah.one/p/:slug*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
