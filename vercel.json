{
  "rewrites": [
    {
      "source": "/preview/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|linkedinbot|telegrambot|slackbot|discordbot|applebot|skypeuripreview).*"
        }
      ],
      "destination": "https://api.revayah.one/preview/:slug*"
    },
    {
      "source": "/p/:slug*",
      "destination": "https://api.revayah.one/p/:slug*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}